# Copy this file to .env and fill in real values. Never commit .env.

# Database (Neon / PostgreSQL)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require"

# Auth (required) - long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=""

# Public URL of the site (used for Stripe redirects, sitemap, share links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Stripe
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# Google sign-in
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""


# Email (OTP + password reset). Without SMTP_USER, codes are only printed to the server log.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="\"Lost & Found\" <noreply@example.com>"
